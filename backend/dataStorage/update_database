-- เพิ่มคอลัมน์ is_active
ALTER TABLE users
ADD COLUMN is_active BOOLEAN DEFAULT TRUE;

-- อัปเดตแถวที่มีอยู่ให้เป็น TRUE
UPDATE users
SET is_active = TRUE
WHERE is_active IS NULL;

-- (ตัวเลือก) ตั้งค่า NOT NULL
ALTER TABLE users
ALTER COLUMN is_active SET NOT NULL;

ALTER TABLE projects
ADD COLUMN address TEXT,
ADD COLUMN is_active BOOLEAN DEFAULT TRUE;

alter table rental_history 
add column water_description text,
add column electricity_description text;

ALTER TABLE projects
DROP COLUMN start_date,
DROP COLUMN end_date;

ALTER TABLE rental_history ADD COLUMN is_locked BOOLEAN DEFAULT false;


